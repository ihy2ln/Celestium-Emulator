<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CelestiumEmulator</AssemblyName>
    <RootNamespace>DroidLauncher</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- File properties shown in Explorer and read by antivirus reputation checks. -->
    <Product>Celestium Emulator</Product>
    <AssemblyTitle>Celestium Emulator</AssemblyTitle>
    <Description>Launcher for the official Android Emulator</Description>
    <Company>ihy2ln</Company>
    <Authors>ihy2ln</Authors>
    <Copyright>Copyright © 2026 ihy2ln</Copyright>
    <!--
      Frozen on purpose. The .exe is a small .NET host that copies its icon, manifest and version stamp from
      here. Keeping all of them, and the SDK (global.json), unchanged makes every update produce a
      byte-identical .exe, so antivirus that already trusts it (Norton CyberCapture) doesn't re-check it.
      Real version: AppInfo.Version in Core.cs. Never bump these.
    -->
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryUrl>https://github.com/ihy2ln/Celestium-Emulator</RepositoryUrl>
    <Deterministic>true</Deterministic>

    <!-- Smaller footprint: no ICU culture data, workstation non-concurrent GC (no background GC thread). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Custom controls are built in code, not the WinForms designer. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="cli/**" />
    <None Remove="cli/**" />
    <None Update="launcher.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Help pages: the same Markdown as docs/ on GitHub, built into the app (the .dll, so the .exe stays unchanged). -->
    <EmbeddedResource Include="docs\0*.md" LogicalName="docs/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
