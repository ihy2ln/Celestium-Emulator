<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>celestium</AssemblyName>
    <RootNamespace>DroidLauncher</RootNamespace>
    <ApplicationIcon>../app.ico</ApplicationIcon>
    <ApplicationManifest>../app.manifest</ApplicationManifest>
    <Product>Celestium Emulator</Product>
    <AssemblyTitle>Celestium Emulator command line</AssemblyTitle>
    <Description>Command-line control for Celestium Emulator instances</Description>
    <Company>ihy2ln</Company>
    <Authors>ihy2ln</Authors>
    <Copyright>Copyright © 2026 ihy2ln</Copyright>
    <!--
      Frozen on purpose. The .exe is a small .NET host that copies its icon, manifest and version stamp from
      here. Keeping all of them, and the SDK (global.json), unchanged makes every update produce a
      byte-identical .exe, so antivirus that already trusts it (Norton CyberCapture) doesn't re-check it.
      Real version: AppInfo.Version in Core.cs. Never bump these.
    -->
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core.cs" Link="Core.cs" />
    <Compile Include="../Profiles.cs" Link="Profiles.cs" />
    <Compile Include="../EmulatorConsole.cs" Link="EmulatorConsole.cs" />
    <Compile Include="../MemoryGuard.cs" Link="MemoryGuard.cs" />
  </ItemGroup>
</Project>
